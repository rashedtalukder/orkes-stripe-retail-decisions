# Copy to .env and fill in your own values. .env is gitignored; never commit real keys.
# Commands load it with: uv run --env-file .env python -m stripe_decisions <command>

# Stripe: a SANDBOX secret key (sk_test_... or rk_test_...). Live keys are rejected by the app.
STRIPE_SECRET_KEY=
# Optional: refuse to run against any Stripe account except this one.
STRIPE_EXPECTED_ACCOUNT=acct_xxxxxxxxxxxxxxxx

# Orkes Conductor application access key (e.g. Developer Edition: https://developer.orkescloud.com/api)
CONDUCTOR_SERVER_URL=https://developer.orkescloud.com/api
CONDUCTOR_AUTH_KEY=
CONDUCTOR_AUTH_SECRET=

# Model providers (only needed for --mode jev / --mode claude and the benchmark)
TYPESAFE_API_KEY=
ANTHROPIC_API_KEY=
# TYPESAFE_MODEL=jev-1.14.0
# ANTHROPIC_MODEL=claude-haiku-5-5
# ANTHROPIC_EFFORT=low

# Real sandbox refunds need BOTH this worker-side flag AND `demo --execute-refunds` (dryRun=false).
# OSD_ALLOW_SANDBOX_REFUNDS=1
